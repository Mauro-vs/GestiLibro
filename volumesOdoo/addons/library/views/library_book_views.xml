<odoo>
  <record id="view_library_book_list" model="ir.ui.view">
    <field name="name">library.book.list</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
      <list decoration-danger="state == 'out_of_stock'" decoration-muted="state == 'discontinued'">
        <field name="name"/>
        <field name="isbn"/>
        <field name="genre_id"/>
        <field name="publisher_id"/>
        <field name="publication_year"/>
        <field name="price_sale"/>
        <field name="stock_total"/>
        <field name="below_minimum_count" string="Tiendas bajo mín."/>
        <field name="state"/>
      </list>
    </field>
  </record>

  <record id="view_library_book_kanban" model="ir.ui.view">
    <field name="name">library.book.kanban</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
      <kanban default_group_by="genre_id">
        <field name="name"/>
        <field name="isbn"/>
        <field name="state"/>
        <field name="genre_id"/>
        <field name="price_sale"/>
        <field name="stock_total"/>
        <field name="publisher_id"/>
        <field name="author_ids"/>
        <field name="publication_year"/>
        <field name="image_small"/>
        <templates>
          <t t-name="card">
            <!-- Portada -->
            <div style="height:160px; overflow:hidden; background:#e9ecef; display:flex; align-items:center; justify-content:center; border-bottom:1px solid #dee2e6;">
              <t t-if="record.image_small.raw_value">
                <field name="image_small" widget="image" class="w-100 h-100"
                       options="{'img_class': 'object-fit-cover w-100 h-100'}" alt="Portada"/>
              </t>
              <t t-else="">
                <i class="fa fa-book fa-4x" style="color:#ced4da;"/>
              </t>
            </div>

            <!-- Cuerpo -->
            <div class="p-2">
              <!-- Título -->
              <strong class="d-block mb-1" style="font-size:13px; line-height:1.3; min-height:32px;">
                <field name="name"/>
              </strong>

              <!-- Autor -->
              <div class="text-muted mb-2" style="font-size:11px;">
                <field name="author_ids" widget="many2many_tags" readonly="1"/>
              </div>

              <!-- Precio y estado -->
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold" style="font-size:13px; color:#0d6efd;">
                  <field name="price_sale" widget="monetary"/>
                </span>
                <field name="state" widget="label_selection"
                       options="{'classes': {'for_sale': 'success', 'out_of_stock': 'danger', 'discontinued': 'secondary'}}"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_library_book_form" model="ir.ui.view">
    <field name="name">library.book.form</field>
    <field name="model">library.book</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <!-- El estado "sin stock" se calcula solo a partir del stock: no se marca a mano. -->
          <button name="action_discontinue" type="object"
                  string="Descatalogar"
                  invisible="state == 'discontinued'"/>
          <button name="action_undiscontinue" type="object"
                  string="Volver al catálogo"
                  class="btn-primary"
                  invisible="state != 'discontinued'"/>
          <field name="state" widget="statusbar" statusbar_visible="for_sale,out_of_stock,discontinued"/>
        </header>
        <sheet>
          <!-- Portada a la derecha del formulario -->
          <field name="image" widget="image" class="oe_avatar" readonly="0"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="Título del libro"/></h1>
          </div>
          <group>
            <group string="Datos del libro">
              <field name="isbn"/>
              <field name="author_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
              <field name="publication_year"/>
              <field name="genre_id" options="{'no_create_edit': True}"/>
              <field name="publisher_id" options="{'no_create_edit': True}"/>
            </group>
            <group string="Precios y stock">
              <field name="price_sale"/>
              <field name="price_cost"/>
              <field name="currency_id"/>
              <field name="stock_total" readonly="1"/>
              <field name="below_minimum_count" readonly="1" string="Tiendas bajo mínimo"/>
            </group>
          </group>
          <group string="Descripción">
            <field name="description" nolabel="1" placeholder="Añade una descripción o sinopsis del libro..."/>
          </group>
          <notebook>
            <page string="Stock por tienda">
              <field name="stock_ids">
                <list editable="bottom" decoration-danger="below_minimum">
                  <field name="store_id" options="{'no_create_edit': True}"/>
                  <field name="quantity"/>
                  <field name="quantity_minimum"/>
                  <field name="below_minimum" string="Bajo mínimo"/>
                </list>
              </field>
            </page>
            <page string="Historial de ventas">
              <field name="order_line_ids" readonly="1">
                <list decoration-info="order_state == 'draft'"
                      decoration-warning="order_state == 'confirmed'"
                      decoration-success="order_state == 'done'"
                      decoration-muted="order_state == 'cancel'">
                  <field name="order_id"/>
                  <field name="order_state" string="Estado"/>
                  <field name="quantity"/>
                  <field name="unit_price"/>
                  <field name="price_subtotal"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_library_book_search" model="ir.ui.view">
    <field name="name">library.book.search</field>
    <field name="model">library.book</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="isbn"/>
        <field name="author_ids"/>
        <field name="publisher_id"/>
        <field name="genre_id"/>
        <filter name="filter_for_sale" string="En venta" domain="[('state', '=', 'for_sale')]"/>
        <filter name="filter_out_of_stock" string="Sin stock" domain="[('state', '=', 'out_of_stock')]"/>
        <filter name="filter_discontinued" string="Descatalogado" domain="[('state', '=', 'discontinued')]"/>
        <filter name="filter_below_minimum" string="Con tiendas bajo mínimo" domain="[('below_minimum_count', '>', 0)]"/>
        <group expand="0" string="Agrupar por">
          <filter name="group_by_publisher" string="Editorial" context="{'group_by': 'publisher_id'}"/>
          <filter name="group_by_genre" string="Género" context="{'group_by': 'genre_id'}"/>
          <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
          <filter name="group_by_year" string="Año" context="{'group_by': 'publication_year'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_library_book" model="ir.actions.act_window">
    <field name="name">Libros</field>
    <field name="res_model">library.book</field>
    <!-- kanban añadido como vista por defecto junto a list y form -->
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_library_book_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Crea tu primer libro</p>
    </field>
  </record>
</odoo>
