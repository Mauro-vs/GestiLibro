<odoo>
  <record id="view_library_order_list" model="ir.ui.view">
    <field name="name">library.order.list</field>
    <field name="model">library.order</field>
    <field name="arch" type="xml">
      <list decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
        <field name="name"/>
        <field name="store_id"/>
        <field name="client_id"/>
        <field name="date"/>
        <field name="state"/>
        <field name="amount_total"/>
      </list>
    </field>
  </record>

  <record id="view_library_order_form" model="ir.ui.view">
    <field name="name">library.order.form</field>
    <field name="model">library.order</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_confirm" type="object" string="Confirmar"
                  class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_done" type="object" string="Marcar como hecho"
                  class="btn-primary" invisible="state != 'confirmed'"/>
          <button name="action_cancel" type="object" string="Cancelar"
                  invisible="state not in ('draft', 'confirmed')"/>
          <button name="action_reset_draft" type="object" string="Volver a borrador"
                  invisible="state != 'cancel'"/>
          <!-- Botón para abrir la factura cuando ya existe -->
          <button name="action_view_invoice" type="object" string="Ver factura"
                  invisible="not invoice_id" class="btn-secondary"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancel"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Datos del pedido">
              <field name="store_id" readonly="state != 'draft'"/>
              <field name="client_id" readonly="state != 'draft'"/>
              <field name="date" readonly="state != 'draft'"/>
              <field name="currency_id" readonly="state != 'draft'"/>
            </group>
            <group string="Cliente">
              <field name="client_is_library_customer" readonly="1"/>
              <field name="client_library_customer_code" readonly="1"/>
              <field name="invoice_id" readonly="1"/>
              <field name="amount_total" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Líneas de venta">
              <field name="line_ids" readonly="state != 'draft'">
                <list editable="bottom">
                  <field name="book_id" domain="[('stock_ids.store_id', '=', parent.store_id), ('stock_ids.quantity', '>', 0)]"/>
                  <field name="quantity"/>
                  <field name="unit_price"/>
                  <field name="price_subtotal" readonly="1"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_library_order_search" model="ir.ui.view">
    <field name="name">library.order.search</field>
    <field name="model">library.order</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="client_id"/>
        <field name="store_id"/>
        <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
        <filter name="filter_confirmed" string="Confirmado" domain="[('state', '=', 'confirmed')]"/>
        <filter name="filter_done" string="Hecho" domain="[('state', '=', 'done')]"/>
        <filter name="filter_cancel" string="Cancelado" domain="[('state', '=', 'cancel')]"/>
        <group expand="0" string="Agrupar por">
          <filter name="group_by_store" string="Tienda" context="{'group_by': 'store_id'}"/>
          <filter name="group_by_client" string="Cliente" context="{'group_by': 'client_id'}"/>
          <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
          <filter name="group_by_date" string="Fecha" context="{'group_by': 'date'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_library_order" model="ir.actions.act_window">
    <field name="name">Ventas</field>
    <field name="res_model">library.order</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_library_order_search"/>
  </record>
</odoo>
