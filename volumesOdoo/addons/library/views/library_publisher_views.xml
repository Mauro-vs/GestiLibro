<odoo>
  <record id="view_library_publisher_list" model="ir.ui.view">
    <field name="name">library.publisher.list</field>
    <field name="model">library.publisher</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="country_id"/>
        <field name="website" widget="url"/>
        <field name="phone"/>
      </list>
    </field>
  </record>

  <record id="view_library_publisher_form" model="ir.ui.view">
    <field name="name">library.publisher.form</field>
    <field name="model">library.publisher</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Nombre de la editorial"/></h1>
          </div>
          <group>
            <field name="country_id"/>
            <field name="website" widget="url"/>
            <field name="phone"/>
          </group>
          <notebook>
            <page string="Libros de la editorial">
              <field name="book_ids" options="{'no_create': True}">
                <list>
                  <field name="name"/>
                  <field name="isbn"/>
                  <field name="genre_id"/>
                  <field name="price_sale"/>
                  <field name="state"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_library_publisher_search" model="ir.ui.view">
    <field name="name">library.publisher.search</field>
    <field name="model">library.publisher</field>
    <field name="type">search</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="country_id"/>
        <group expand="0" string="Agrupar por">
          <filter name="group_by_country" string="País" context="{'group_by': 'country_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_library_publisher" model="ir.actions.act_window">
    <field name="name">Editoriales</field>
    <field name="res_model">library.publisher</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_library_publisher_search"/>
  </record>

</odoo>
