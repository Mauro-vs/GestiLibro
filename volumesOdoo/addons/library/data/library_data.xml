  <record id="demo_author_1" model="library.author">
    <field name="name">Gabriel García Márquez</field>
    <field name="nationality">Colombia</field>
    <field name="date_of_birth">1927-03-06</field>
    <field name="biography">Premio Nobel de Literatura 1982. Máximo exponente del realismo mágico latinoamericano, conocido mundialmente por Cien años de soledad.</field>
  </record>

  <record id="demo_author_2" model="library.author">
    <field name="name">Isabel Allende</field>
    <field name="nationality">Chile</field>
    <field name="date_of_birth">1942-08-02</field>
    <field name="biography">Una de las escritoras latinoamericanas más leídas del mundo. Su obra mezcla realidad y fantasía con una fuerte perspectiva femenina.</field>
  </record>

  <record id="demo_author_3" model="library.author">
    <field name="name">Jorge Luis Borges</field>
    <field name="nationality">Argentina</field>
    <field name="date_of_birth">1899-08-24</field>
    <field name="biography">Maestro del cuento filosófico y del relato fantástico. Considerado uno de los escritores más importantes del siglo XX en lengua española.</field>
  </record>

  <record id="demo_author_4" model="library.author">
    <field name="name">Mario Vargas Llosa</field>
    <field name="nationality">Perú</field>
    <field name="date_of_birth">1936-03-28</field>
    <field name="biography">Premio Nobel de Literatura 2010. Novelista, ensayista y político peruano, figura central de la narrativa latinoamericana contemporánea.</field>
  </record>

  <record id="demo_author_5" model="library.author">
    <field name="name">Julio Cortázar</field>
    <field name="nationality">Argentina</field>
    <field name="date_of_birth">1914-08-26</field>
    <field name="biography">Renovador del cuento y la novela en lengua española. Su obra Rayuela es un hito de la literatura experimental del siglo XX.</field>
  </record>

  <record id="demo_author_6" model="library.author">
    <field name="name">Ernest Hemingway</field>
    <field name="nationality">Estados Unidos</field>
    <field name="date_of_birth">1899-07-21</field>
    <field name="biography">Premio Nobel de Literatura 1954. Su estilo sobrio e iceberg theory influyeron profundamente en la narrativa del siglo XX.</field>
  </record>

  <record id="demo_author_7" model="library.author">
    <field name="name">Franz Kafka</field>
    <field name="nationality">República Checa</field>
    <field name="date_of_birth">1883-07-03</field>
    <field name="biography">Escritor de lengua alemana cuya obra explora la alienación y la burocracia. Su nombre dio lugar al adjetivo kafkiano.</field>
  </record>

  <record id="demo_author_8" model="library.author">
    <field name="name">Fiódor Dostoyevski</field>
    <field name="nationality">Rusia</field>
    <field name="date_of_birth">1821-11-11</field>
    <field name="biography">Uno de los grandes novelistas de la literatura universal. Exploró la psicología humana, la moral y la condición existencial en sus obras.</field>
  </record>

  <record id="demo_author_9" model="library.author">
    <field name="name">León Tolstói</field>
    <field name="nationality">Rusia</field>
    <field name="date_of_birth">1828-09-09</field>
    <field name="biography">Maestro de la novela realista rusa. Guerra y paz y Ana Karenina son consideradas obras cumbre de la literatura mundial.</field>
  </record>

  <record id="demo_author_10" model="library.author">
    <field name="name">Miguel de Cervantes</field>
    <field name="nationality">España</field>
    <field name="date_of_birth">1547-09-29</field>
    <field name="biography">Autor de El ingenioso hidalgo don Quijote de la Mancha, considerada la primera novela moderna y una de las obras más importantes de la literatura universal.</field>
  </record>

  <record id="demo_author_11" model="library.author">
    <field name="name">Federico García Lorca</field>
    <field name="nationality">España</field>
    <field name="date_of_birth">1898-06-05</field>
    <field name="biography">Poeta y dramaturgo español de la Generación del 27. Sus obras teatrales y poéticas son referentes de la literatura española del siglo XX.</field>
  </record>

  <record id="demo_author_12" model="library.author">
    <field name="name">Pablo Neruda</field>
    <field name="nationality">Chile</field>
    <field name="date_of_birth">1904-07-12</field>
    <field name="biography">Premio Nobel de Literatura 1971. Uno de los poetas en lengua española más influyentes del siglo XX, conocido por sus Veinte poemas de amor.</field>
  </record>

