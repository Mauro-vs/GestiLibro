<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuencia para generar referencias de pedidos tipo ORD/2026/0001 -->
    <record id="sequence_library_order" model="ir.sequence">
        <field name="name">Secuencia Pedido Librería</field>
        <field name="code">library.order</field>
        <field name="prefix">ORD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
